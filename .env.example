# Existing TMDB configuration
VITE_TMDB_KEY=your_tmdb_key
VITE_BASE_URL=https://api.themoviedb.org/3

# Public project token from PostHog project settings (never a personal API key).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=true
# Local development is excluded from analytics unless explicitly enabled.
VITE_POSTHOG_CAPTURE_IN_DEV=false
# Optional: also enable Record user sessions in PostHog project settings.
VITE_POSTHOG_SESSION_REPLAY=false
